# Copy this file to `.env` and fill in real values.
# Loaded by src/app/core/config.py via pydantic-settings.

APP_NAME="Stock Analysis Platform"
APP_ENV=local
DEBUG=true

# PostgreSQL (async driver: asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stock_analysis

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Excel watchlist source
WATCHLIST_EXCEL_PATH=./data/watchlists/watchlist.xlsx

# Chartink source (screener URL/config will be added when the source is implemented)
CHARTINK_BASE_URL=https://chartink.com

# Yahoo Finance source
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

LOG_LEVEL=INFO

# Telegram bot for stock_monitor.py breakout alerts.
# Get a token from @BotFather on Telegram, and your chat_id by messaging
# @userinfobot (or your group) and reading the reply.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
